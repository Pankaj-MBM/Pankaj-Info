# Public URL of the site — canonical URLs, Open Graph tags and the sitemap. Defaults to https://pankaj.2026.co.in
SITE_URL=

# Contact-form endpoint (the Catalyst function in functions/contact). Empty = Gmail/WhatsApp hand-off.
# Enable once Catalyst Mail has a verified private-domain sender: https://pankaj.2026.co.in/server/contact/
PUBLIC_CONTACT_ENDPOINT=
