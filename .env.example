# Public URL of the site — canonical URLs, Open Graph tags and the sitemap. Defaults to https://pankaj.2026.co.in
SITE_URL=

# Contact-form endpoint (the Catalyst function in functions/contact). Defaults to
# https://pankaj.2026.co.in/server/contact/ — set it empty to fall back to the Gmail/WhatsApp hand-off.
PUBLIC_CONTACT_ENDPOINT=
