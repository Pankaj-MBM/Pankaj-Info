---
import { withBase } from '@/lib/url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
---

<BaseLayout title="Page not found · Pankaj Parihar" description="This page doesn’t exist." noindex>
  <section class="container-page grid min-h-[70vh] place-items-center py-16 text-center">
    <div class="max-w-xl">
      <svg viewBox="0 0 360 170" class="mx-auto w-full max-w-sm" aria-hidden="true">
        <circle cx="290" cy="40" r="22" fill="var(--accent)" opacity=".9"></circle>
        <g fill="var(--primary)">
          <path d="M14 168V96h58v72z" opacity=".55"></path>
          <path d="M70 168V70h66v98z" opacity=".85"></path>
          <path d="M134 168V52a36 36 0 0 1 72 0v116z"></path>
          <path d="M204 168V84h62v84z" opacity=".7"></path>
          <path d="M264 168V104h82v64z" opacity=".5"></path>
        </g>
        <g fill="var(--bg)">
          <path d="M160 168v-34a10 10 0 0 1 20 0v34z"></path>
          <rect x="88" y="92" width="12" height="16" rx="6"></rect>
          <rect x="108" y="92" width="12" height="16" rx="6"></rect>
          <rect x="222" y="104" width="12" height="16" rx="6"></rect>
          <rect x="240" y="104" width="12" height="16" rx="6"></rect>
          <rect x="30" y="112" width="10" height="14" rx="5"></rect>
          <rect x="290" y="122" width="12" height="16" rx="6"></rect>
        </g>
      </svg>
      <p class="eyebrow mt-10">Error 404</p>
      <h1 class="mt-3 text-[clamp(2rem,5vw,3.25rem)] leading-tight font-bold tracking-[-0.03em]">
        Lost in the <span class="accent-serif text-primary">Blue City?</span>
      </h1>
      <p class="mt-4 text-lg text-muted">This page doesn’t exist — but plenty of good things do.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase('/')} class="btn btn-primary"><Icon name="lucide:house" class="size-4" /> Home</a>
        <a href={withBase('/#projects')} class="btn btn-secondary">Projects</a>
        <a href={withBase('/#contact')} class="btn btn-secondary">Contact</a>
      </div>
      <p class="mt-6 text-sm text-muted">Tip: press <kbd class="kbd">Ctrl</kbd> <kbd class="kbd">K</kbd> to search.</p>
    </div>
  </section>
</BaseLayout>
