---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { email, profile } from '@/data/profile';
import { experience } from '@/data/experience';
import { achievements, certifications, education } from '@/data/education';
import { alsoSkills, coreSkills, familiarSkills, toolSkills } from '@/data/skills';
import { experienceLabel, formatPeriod } from '@/lib/format';
import { getProjects } from '@/lib/projects';

const projects = (await getProjects()).filter((p) => !p.data.draft).slice(0, 4);
const { resume, socials, location } = profile;
---

<BaseLayout
  title="Resume — Pankaj Parihar, Software Engineer (Angular, .NET)"
  description="Experience, skills and education of Pankaj Parihar — Software Engineer (Angular, ASP.NET Core, Azure OpenAI). Download as PDF or print."
>
  <div class="container-page pt-8 pb-16 md:pt-12">
    <div class="no-print flex flex-wrap items-center justify-between gap-4">
      <p class="text-sm text-muted">Last updated {resume.updated}</p>
      <div class="flex flex-wrap gap-2">
        <a href={resume.pdf} class="btn btn-primary btn-sm" download data-track="resume_download" data-track-source="resume-page">
          <Icon name="lucide:download" class="size-4" /> Download PDF
        </a>
        {
          resume.docx && (
            <a href={resume.docx} class="btn btn-secondary btn-sm" download data-track="resume_download" data-track-source="resume-page-docx">
              <Icon name="lucide:file-text" class="size-4" /> Download Word
            </a>
          )
        }
        <button type="button" class="btn btn-secondary btn-sm" data-print>
          <Icon name="lucide:printer" class="size-4" /> Print
        </button>
      </div>
    </div>

    <article class="card mx-auto mt-6 max-w-[52rem] p-6 sm:p-10 print:border-0 print:p-0">
      <header class="border-b border-line pb-6">
        <h1 class="text-4xl font-bold tracking-[-0.03em]">{profile.name}</h1>
        <p class="mt-1 text-lg font-medium text-primary">{profile.roleLong} · {profile.tagline}</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
          <li>{location.city ? `${location.city}, ` : ''}{location.region}, {location.country}</li>
          <li><a class="link" href={`mailto:${email}`}>{email}</a></li>
          <li>{profile.contact.phoneDisplay}</li>
          <li><a class="link print-url" href={socials.linkedin}>LinkedIn</a></li>
          <li><a class="link print-url" href={socials.github}>GitHub</a></li>
        </ul>
      </header>

      <section class="mt-6" aria-labelledby="r-summary">
        <h2 id="r-summary" class="eyebrow">Summary</h2>
        <p class="mt-2">{profile.summary}</p>
        <p class="mt-2 text-sm text-muted">Total experience: {experienceLabel()}</p>
      </section>

      <section class="mt-7" aria-labelledby="r-experience">
        <h2 id="r-experience" class="eyebrow">Experience</h2>
        <ol class="mt-3 grid gap-6">
          {
            experience.map((job) => (
              <li class="break-inside-avoid">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <h3 class="text-lg font-semibold">
                    {job.role} · <span class="text-primary">{job.company}</span>
                  </h3>
                  <p class="text-sm text-muted">
                    {formatPeriod(job.start, job.end)} · {job.location}
                  </p>
                </div>
                <ul class="mt-2 list-disc space-y-1 pl-5 marker:text-primary">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-7 break-inside-avoid" aria-labelledby="r-skills">
        <h2 id="r-skills" class="eyebrow">Skills</h2>
        <dl class="mt-3 grid gap-2 text-[0.95rem]">
          <div><dt class="inline font-semibold">Core: </dt><dd class="inline">{coreSkills.map((s) => s.name).join(', ')}</dd></div>
          <div><dt class="inline font-semibold">Also: </dt><dd class="inline">{alsoSkills.map((s) => s.name).join(', ')}</dd></div>
          <div><dt class="inline font-semibold">Familiar: </dt><dd class="inline">{familiarSkills.join(', ')}</dd></div>
          <div><dt class="inline font-semibold">Tools & practices: </dt><dd class="inline">{toolSkills.map((s) => s.name).join(', ')}</dd></div>
        </dl>
      </section>

      <section class="mt-7 break-inside-avoid" aria-labelledby="r-projects">
        <h2 id="r-projects" class="eyebrow">Selected projects</h2>
        <ul class="mt-3 grid gap-2">
          {
            projects.map((p) => (
              <li>
                <a href={`/projects/${p.id}/`} class="font-semibold hover:text-primary">{p.data.title}</a>
                <span class="text-muted"> — {p.data.summary}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-7 break-inside-avoid" aria-labelledby="r-education">
        <h2 id="r-education" class="eyebrow">Education</h2>
        <ul class="mt-3 grid gap-2">
          {
            education.map((e) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4">
                <span>
                  <span class="font-semibold">{e.degree} ({e.short})</span> — {e.school}, {e.place}
                </span>
                <span class="text-sm text-muted">
                  {e.year ? `${e.year} · ` : ''}
                  {e.score}
                </span>
              </li>
            ))
          }
        </ul>
        {
          certifications.length > 0 && (
            <ul class="mt-3 grid gap-1">
              {certifications.map((c) => (
                <li>
                  {c.name} — {c.issuer} ({c.year})
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="mt-7 break-inside-avoid" aria-labelledby="r-achievements">
        <h2 id="r-achievements" class="eyebrow">Achievements</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 marker:text-primary">
          {achievements.map((a) => <li>{a}</li>)}
        </ul>
      </section>

      <section class="mt-7 break-inside-avoid" aria-labelledby="r-languages">
        <h2 id="r-languages" class="eyebrow">Languages</h2>
        <p class="mt-2">{profile.languages.join(' · ')}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
