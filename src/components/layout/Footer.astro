---
import { withBase } from '@/lib/url';
import { sections } from '@/data/nav';
import { profile } from '@/data/profile';
import Logo from '../ui/Logo.astro';

const home = withBase('/');
const base = [home, home.replace(/\/$/, '')].includes(Astro.url.pathname) ? '' : home;
const now = new Date();
const updated = now.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<footer class="site-footer mt-6 border-t border-line">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href={withBase('/')} class="inline-flex items-center gap-3 font-semibold"><Logo class="size-9" /> Pankaj Parihar</a>
      <p class="mt-4 max-w-xs text-sm text-muted">
        Software engineer building AI-powered business software with Angular, ASP.NET Core and Azure.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="grid gap-2 text-sm">
        {
          sections.map((s) => (
            <li>
              <a href={`${base}#${s.id}`} class="footer-link">{s.label}</a>
            </li>
          ))
        }
        <li><a href={withBase('/resume/')} class="footer-link">Résumé</a></li>
      </ul>
    </nav>
    <ul class="grid content-start gap-2 text-sm">
      <li><a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn ↗</a></li>
      <li><a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a></li>
      {profile.socials.naukri && <li><a href={profile.socials.naukri} target="_blank" rel="noopener noreferrer" class="footer-link">Naukri ↗</a></li>}
      <li><button type="button" class="footer-link" data-copy-email>Copy email</button></li>
      <li><a href="#contact" class="footer-link" data-whatsapp>WhatsApp ↗</a></li>
    </ul>
  </div>
  <div class="container-page flex flex-col gap-2 border-t border-line py-6 text-xs text-muted md:flex-row md:justify-between">
    <p>© {now.getFullYear()} Pankaj Parihar · Designed &amp; built by me</p>
    <p>
      No cookies · Updated <time datetime={now.toISOString().slice(0, 10)}>{updated}</time> ·
      <a href="#main" class="footer-link">Back to top ↑</a>
    </p>
  </div>
</footer>
