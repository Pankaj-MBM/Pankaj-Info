---
/** "Ask Pankaj" — scripted recruiter-FAQ assistant (Roadmap §4.5-A). One instance per placement. */
import { chatFallback, chatGreeting, faq } from '@/data/faq';
import Icon from '../ui/Icon.astro';

interface Props {
  id: string;
  variant?: 'inline' | 'sheet';
}
const { id, variant = 'inline' } = Astro.props;
const payload = { items: faq, fallback: chatFallback };
const firstChips = faq.slice(0, 4);
---

<ask-pankaj class="chat h-full" data-variant={variant} data-hero-chat={variant === 'inline' ? '' : undefined}>
  <script is:inline type="application/json" set:html={JSON.stringify(payload)} />
  <div class="chat-head">
    <span class="chat-avatar" aria-hidden="true">PP</span>
    <div class="min-w-0 flex-1">
      <p class="chat-title" id={`${id}-title`}>Ask Pankaj</p>
      <p class="chat-sub"><span class="status-dot"></span> Scripted assistant · instant answers</p>
    </div>
    <button type="button" class="icon-btn size-9" data-chat-reset aria-label="Start the conversation over">
      <Icon name="lucide:rotate-ccw" class="size-4" />
    </button>
    {
      variant === 'sheet' && (
        <button type="button" class="icon-btn size-9" data-dialog-close aria-label="Close chat">
          <Icon name="lucide:x" class="size-5" />
        </button>
      )
    }
  </div>
  <div class="chat-log" role="log" aria-labelledby={`${id}-title`} data-chat-log>
    <div class="msg msg-bot"><p class="msg-bubble">{chatGreeting}</p></div>
  </div>
  <div class="chat-chips" data-chat-chips aria-label="Suggested questions" role="group">
    {
      firstChips.map((item) => (
        <button type="button" class="chat-chip" data-q={item.id}>
          {item.question}
        </button>
      ))
    }
  </div>
  <form class="chat-form" data-chat-form autocomplete="off">
    <label class="sr-only" for={`${id}-input`}>Ask a question</label>
    <input id={`${id}-input`} type="text" maxlength="200" placeholder="Ask about skills, experience…" />
    <button type="submit" class="chat-send" aria-label="Send question">
      <Icon name="lucide:send" class="size-4" />
    </button>
  </form>
  <noscript>
    <div class="chat-noscript">
      {
        faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p class="pb-2 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </noscript>
</ask-pankaj>

<script>
  import '@/scripts/chat';
</script>
