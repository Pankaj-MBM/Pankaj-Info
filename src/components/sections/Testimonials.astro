---
/** Renders nothing until real LinkedIn recommendations are added (never fabricate). */
import { testimonials } from '@/data/education';
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="section" aria-labelledby="testimonials-title">
      <div class="container-page">
        <p class="lx-eyebrow">Recommendations</p>
        <h2 id="testimonials-title" class="lx-title mt-5">
          Kind <span class="lx-serif">words.</span>
        </h2>
        <ul class="mt-14 grid gap-12 md:grid-cols-2">
          {testimonials.map((t) => (
            <li class="border-t border-line pt-8" data-reveal>
              <blockquote class="text-2xl leading-snug font-medium tracking-[-0.02em]">“{t.quote}”</blockquote>
              <p class="mt-6 font-semibold">{t.name}</p>
              <p class="text-sm text-muted">
                {t.role} · {t.relation}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
