---
import { certifications, education } from '@/data/education';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container-page">
    <SectionHeading id="education-title" index="05" eyebrow="Education" title="Grounded in" accent="computer science." />

    <ul class="mt-12 grid gap-4 md:grid-cols-2">
      {
        education.map((e, i) => (
          <li class="card flex gap-5 p-6 md:p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-surface-2 text-primary">
              <Icon name="lucide:graduation-cap" class="size-6" />
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <h3 class="text-lg font-semibold tracking-[-0.01em]">
                  {e.degree} <span class="text-muted">({e.short})</span>
                </h3>
                <span class="chip !bg-transparent font-semibold text-primary">{e.score}</span>
              </div>
              <p class="mt-1 font-medium">{e.school}</p>
              <p class="mt-0.5 text-sm text-muted">
                {e.place}
                {e.year && ` · ${e.year}`}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    {
      certifications.length > 0 && (
        <>
          <h3 class="mt-12 text-sm font-semibold tracking-[0.08em] text-muted uppercase">Certifications</h3>
          <ul class="mt-5 grid gap-4 md:grid-cols-3">
            {certifications.map((c) => (
              <li class="card p-5">
                <p class="font-semibold">{c.name}</p>
                <p class="mt-1 text-sm text-muted">
                  {c.issuer} · {c.year}
                </p>
                {c.url && (
                  <a href={c.url} class="link mt-3 inline-block text-sm" target="_blank" rel="noopener noreferrer">
                    Verify credential
                  </a>
                )}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>
