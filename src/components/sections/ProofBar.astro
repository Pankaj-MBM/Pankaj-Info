---
import { techStrip } from '@/data/skills';
import { experienceYears } from '@/lib/format';
import Icon from '../ui/Icon.astro';

const years = experienceYears();
const stats = [
  { count: years, decimals: years % 1 ? 1 : 0, suffix: '+', unit: 'yrs', label: 'Hands-on experience', sr: `${years}+ years of experience` },
  { count: 40, decimals: 0, suffix: '+', label: 'REST APIs shipped', sr: '40+ REST APIs shipped' },
  { text: 'RAG', label: 'AI chatbot on Azure OpenAI + AI Search' },
  { text: 'WhatsApp', label: 'Cloud API: templates, media, webhooks, bulk' },
  { count: 84, decimals: 0, suffix: '%', label: 'MCA · MBM University', sr: '84% in MCA at MBM University' },
];
---

<section aria-label="Highlights" class="relative border-y border-line bg-surface/60">
  <div class="container-page">
    <ul class="grid grid-cols-2 gap-px overflow-hidden md:grid-cols-5">
      {
        stats.map((s, i) => (
          <li class:list={['px-1 py-7 md:px-5', i === stats.length - 1 && 'col-span-2 md:col-span-1']} data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p
              class:list={[
                'text-gradient leading-none font-bold tracking-[-0.03em]',
                'count' in s ? 'text-[clamp(1.9rem,4vw,2.6rem)]' : 'text-[clamp(1.6rem,3vw,2.1rem)]',
              ]}
            >
              {'count' in s ? (
                <>
                  <span aria-hidden="true" class="whitespace-nowrap"><span data-count-to={s.count} data-decimals={s.decimals}>{s.count?.toFixed(s.decimals)}</span>{s.suffix}{s.unit && <span class="ml-1 text-[0.5em] font-semibold tracking-normal">{s.unit}</span>}</span>
                  <span class="sr-only">{s.sr}</span>
                </>
              ) : (
                s.text
              )}
            </p>
            <p class="mt-2 text-sm text-muted">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-line">
    <div class="container-page flex items-center gap-3 py-4" data-marquee>
      <p class="sr-only">Technologies: {techStrip.map((t) => t.name).join(', ')}</p>
      <div class="marquee flex-1" aria-hidden="true">
        <ul class="marquee-track">
          {
            [...techStrip, ...techStrip].map((t) => (
              <li class="flex items-center gap-2 pr-10 text-sm font-medium whitespace-nowrap text-muted">
                <Icon name={t.icon} class="size-5" />
                {t.name}
              </li>
            ))
          }
        </ul>
      </div>
      <button type="button" class="icon-btn marquee-toggle size-9 shrink-0" data-marquee-toggle aria-pressed="false" aria-label="Pause the technology logos animation">
        <Icon name="lucide:pause" class="icon-pause size-4" />
        <Icon name="lucide:play" class="icon-play size-4" />
      </button>
    </div>
  </div>
</section>
