---
/** Selected work: bento gallery for the headline projects + an editorial list for the rest. */
import { Image } from 'astro:assets';
import { getProjects, type Project } from '@/lib/projects';
import Icon from '../ui/Icon.astro';
import ProjectCover from '../ui/ProjectCover.astro';

const projects = await getProjects();
const bentoIds = ['2026-co-in', 'ai-crm-whatsapp', 'setu', 'geo-tracker', 'suvidha'];
const bento = bentoIds.map((id) => projects.find((p) => p.id === id)).filter((p): p is Project => Boolean(p));
const rest = projects.filter((p) => !bentoIds.includes(p.id));
const short = (p: Project) => p.data.summary.split(' — ')[0];
const tag = (p: Project) =>
  p.data.badge ?? (p.data.illustration ? 'Illustrative UI' : p.data.visibility === 'public' ? 'Open source' : 'Product');
---

<section id="projects" class="section" aria-labelledby="work-title">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="lx-eyebrow">Selected work</p>
        <h2 id="work-title" class="lx-title mt-5">Products built to be <span class="lx-serif">used.</span></h2>
      </div>
      <p class="lx-lead max-w-sm">From an enterprise CRM with AI to a QR-ordering platform running in real cafés.</p>
    </div>

    <div class="lx-bento mt-14">
      {
        bento.map((p, i) => (
          <a href={`/projects/${p.id}/`} class="lx-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            {p.data.cover ? (
              <Image src={p.data.cover} alt="" widths={[640, 960, 1280]} sizes={i === 0 ? '(min-width:900px) 45vw, 100vw' : '(min-width:900px) 28vw, 100vw'} loading="lazy" />
            ) : (
              <ProjectCover project={p} />
            )}
            <span class="lx-card-tag">{tag(p)}</span>
            <h3>{p.data.title.split(' — ')[0]}</h3>
            <p>{short(p)}</p>
            <span class="lx-card-arrow" aria-hidden="true"><Icon name="lucide:arrow-up-right" class="size-5" /></span>
          </a>
        ))
      }
    </div>

    {
      rest.length > 0 && (
        <ul class="lx-list mt-16">
          {rest.map((p) => (
            <li data-reveal>
              <a href={`/projects/${p.id}/`} class="lx-row">
                <span class="lx-row-title">
                  {p.data.title.split(' — ')[0]}
                  {p.data.draft && <span class="lx-gold text-sm font-medium"> · draft</span>}
                </span>
                <span class="lx-row-text">{short(p)}</span>
                <span class="lx-row-arrow" aria-hidden="true"><Icon name="lucide:arrow-right" class="size-4" /></span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
