---
import { Image } from 'astro:assets';
import { profile } from '@/data/profile';
import LocalTime from '../features/LocalTime.astro';
import Icon from '../ui/Icon.astro';
import JaaliPattern from '../ui/JaaliPattern.astro';
import shotQr from '@/assets/projects/2026-co-in.png';
import shotCrm from '@/assets/projects/ai-crm-whatsapp.png';
import shotGeo from '@/assets/projects/geo-tracker.png';

const { availability, socials, resume, location, headline } = profile;
const words = headline.rotating;
const windows = [
  { img: shotGeo, label: 'geo-tracker · concept', cls: 'win-back', href: '/projects/geo-tracker/', name: 'Geo Tracker', eager: false },
  { img: shotCrm, label: 'whatsapp-crm · concept', cls: 'win-mid', href: '/projects/ai-crm-whatsapp/', name: 'WhatsApp CRM', eager: false },
  { img: shotQr, label: '2026.co.in · live', cls: 'win-front', href: '/projects/2026-co-in/', name: '2026.co.in', eager: true, live: true },
];
---

<section id="top" class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <JaaliPattern id="hero" class="hero-jaali" />
    <div class="hero-glow"></div>
  </div>

  <div
    class="container-page relative grid items-center gap-12 pt-10 pb-16 md:pt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-12 lg:pt-16 lg:pb-24"
  >
    <div>
      <div class="hero-in flex flex-wrap items-center gap-2" style="--d:0ms">
        <p class="status-chip">
          <span class="status-dot"></span>
          <span>{availability.statusLabel}</span>
          {availability.noticePeriod && <span class="text-muted">· Notice: {availability.noticePeriod}</span>}
        </p>
        <p class="status-chip text-muted">
          <Icon name="lucide:briefcase" class="size-4 text-primary" /> Software Engineer @ Dial ERP
        </p>
      </div>

      <h1 id="hero-title" class="mt-6 text-[clamp(3rem,8.5vw,5.75rem)] leading-[0.92] font-bold tracking-[-0.045em]">
        <span class="block">Pankaj</span>
        <span class="text-gradient block pb-1">Parihar</span>
      </h1>

      <div class="hero-in mt-6" style="--d:100ms">
        <p class="text-[clamp(1.1rem,2.1vw,1.35rem)] font-medium text-muted">{headline.lead}</p>
        <p class="rotator accent-serif text-[clamp(2.1rem,4.8vw,3.4rem)] text-primary" aria-hidden="true">
          <span class="rotator-track">{[...words, words[0]].map((w) => <span>{w}</span>)}</span>
        </p>
        <p class="text-[clamp(1.1rem,2.1vw,1.35rem)] font-medium">{headline.rest}</p>
        <p class="sr-only">{headline.lead} {words.join(', ')} {headline.rest}</p>
      </div>

      <p class="hero-in mt-5 max-w-[34rem] text-muted" style="--d:160ms">{profile.pitch}</p>

      <div class="hero-in mt-8 flex flex-wrap items-center gap-3" style="--d:220ms">
        <a href={resume.pdf} class="btn btn-primary" download data-track="resume_download" data-track-source="hero">
          <Icon name="lucide:download" class="size-[1.15rem]" /> Download resume
        </a>
        <a href="#projects" class="btn btn-secondary">
          See my work <Icon name="lucide:arrow-right" class="size-[1.15rem]" />
        </a>
        <a href="/resume/" class="btn btn-ghost" data-open-summary>
          <Icon name="lucide:zap" class="size-[1.15rem] text-accent-ink" /> 30-sec summary
        </a>
      </div>

      <div class="hero-in mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-muted" style="--d:280ms">
        <ul class="-ml-2.5 flex items-center" aria-label="Profiles and contact">
          <li>
            <a href={socials.linkedin} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile (opens in a new tab)" data-track="linkedin_click" data-track-source="hero">
              <Icon name="si:linkedin" class="size-5" />
            </a>
          </li>
          <li>
            <a href={socials.github} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (opens in a new tab)" data-track="github_click" data-track-source="hero">
              <Icon name="si:github" class="size-5" />
            </a>
          </li>
          {
            socials.naukri && (
              <li>
                <a href={socials.naukri} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Naukri profile (opens in a new tab)">
                  <Icon name="lucide:briefcase" class="size-5" />
                </a>
              </li>
            )
          }
          <li>
            <button type="button" class="icon-btn" data-copy-email aria-label="Copy email address">
              <Icon name="lucide:mail" class="size-5" />
            </button>
          </li>
          <li>
            <a href="#contact" class="icon-btn" data-whatsapp aria-label="Chat on WhatsApp (opens in a new tab)">
              <Icon name="si:whatsapp" class="size-5" />
            </a>
          </li>
        </ul>
        <span class="hidden h-5 w-px bg-line sm:block" aria-hidden="true"></span>
        <p class="flex items-center gap-1.5">
          <Icon name="lucide:map-pin" class="size-4" />
          {location.city ? `${location.city}, ` : ''}{location.country}
        </p>
        <p class="flex items-center gap-1.5">
          <Icon name="lucide:clock" class="size-4" />
          <span class="sr-only">Local time:</span>
          <LocalTime />
        </p>
      </div>
    </div>

    <div class="hero-in relative" style="--d:140ms">
      <div class="showcase">
        <div class="showcase-arch" aria-hidden="true"></div>
        {
          windows.map((w) => (
            <a href={w.href} class:list={['win', w.cls]} aria-label={`${w.name} — case study`}>
              <span class="win-bar" aria-hidden="true">
                <i />
                <i />
                <i />
                <span class="win-url">
                  {w.live && <span class="live-dot" />}
                  {w.label}
                </span>
              </span>
              <Image
                src={w.img}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 36vw, 92vw"
                loading={w.eager ? 'eager' : 'lazy'}
                fetchpriority={w.eager ? 'high' : 'auto'}
              />
            </a>
          ))
        }
        <div class="ask-mini" data-hero-chat>
          <span class="chat-avatar" aria-hidden="true">PP</span>
          <div class="min-w-0">
            <p class="text-sm font-semibold">Ask Pankaj <span class="font-normal text-muted">· instant answers</span></p>
            <p class="mt-0.5 text-sm text-muted">Hi 👋 Ask about my stack, experience or best work.</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <button type="button" class="chat-chip" data-ask="stack">Tech stack?</button>
              <button type="button" class="chat-chip" data-ask="experience">Experience?</button>
              <button type="button" class="chat-chip" data-ask="best-project">Best project?</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
