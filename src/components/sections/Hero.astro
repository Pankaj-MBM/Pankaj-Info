---
import { profile } from '@/data/profile';
import LocalTime from '../features/LocalTime.astro';
import Icon from '../ui/Icon.astro';

const { resume, availability } = profile;
const ticker = ['CRM & ERP platforms', 'WhatsApp automation', 'QR ordering', 'AI assistants', 'Inventory systems', 'Field-sales tracking'];
---

<section id="top" class="hero-cine" aria-labelledby="hero-title" data-hero-chat>
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

  <div class="container-page relative flex min-h-[calc(100svh-4rem)] flex-col justify-between gap-12 pt-8 pb-10 md:pt-12">
    <div class="hero-meta">
      <span>Pankaj Parihar</span>
      <span class="hidden sm:inline">Software Engineer</span>
      <span>India · <LocalTime /></span>
      <span class="hero-avail"><i aria-hidden="true"></i>{availability.statusLabel}</span>
    </div>

    <h1 id="hero-title" class="display">
      <span class="line" style="--i:0"><span>I build software</span></span>
      <span class="line" style="--i:1"><span>that businesses</span></span>
      <span class="line" style="--i:2"><span><em class="accent-serif text-primary">run on.</em></span></span>
    </h1>

    <div class="hero-foot grid items-end gap-8 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] md:gap-16">
      <p class="hero-lead">{profile.pitch}</p>
      <nav aria-label="Get started" class="hero-links">
        <a href="#projects"><span>Selected work</span><Icon name="lucide:arrow-down" class="size-5" /></a>
        <a href={resume.pdf} download data-track="resume_download" data-track-source="hero"><span>Résumé — PDF</span><Icon name="lucide:arrow-up-right" class="size-5" /></a>
        <a href="/resume/" data-open-summary><span>30-second summary</span><Icon name="lucide:zap" class="size-5" /></a>
        <a href="#contact"><span>Get in touch</span><Icon name="lucide:arrow-right" class="size-5" /></a>
      </nav>
    </div>
  </div>

  <div class="ticker" data-marquee>
    <p class="sr-only">What I build: {ticker.join(', ')}</p>
    <div class="marquee flex-1" aria-hidden="true">
      <ul class="marquee-track">
        {
          [...ticker, ...ticker].map((t) => (
            <li class="ticker-item">
              {t}
              <span class="ticker-star">✦</span>
            </li>
          ))
        }
      </ul>
    </div>
    <button type="button" class="icon-btn marquee-toggle size-9 shrink-0" data-marquee-toggle aria-pressed="false" aria-label="Pause the moving text">
      <Icon name="lucide:pause" class="icon-pause size-4" />
      <Icon name="lucide:play" class="icon-play size-4" />
    </button>
  </div>
</section>
