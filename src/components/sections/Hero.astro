---
import { Image } from 'astro:assets';
import { profile } from '@/data/profile';
import { techStrip } from '@/data/skills';
import { experienceYears } from '@/lib/format';
import { getProjects } from '@/lib/projects';
import Icon from '../ui/Icon.astro';
import shotQr from '@/assets/projects/2026-co-in.png';
import photo from '@/assets/profile/pankaj.jpg';
import HeroBackdrop from '../ui/HeroBackdrop.astro';

const { resume, availability } = profile;
const projectCount = (await getProjects()).filter((p) => !p.data.draft).length;
const stats = [
  { value: `${experienceYears()}+`, label: 'Years shipping production software' },
  { value: '40+', label: 'REST APIs designed and in production' },
  { value: String(projectCount), label: 'Products and projects delivered' },
  { value: '84%', label: 'MCA, MBM University' },
];
---

<section id="top" class="lx-hero" aria-labelledby="hero-title" data-hero-chat data-parallax>
  <div class="lx-hero-glow" aria-hidden="true"></div>
  <HeroBackdrop />
  <div class="container-page grid items-center gap-14 pt-10 pb-16 md:pt-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-10 lg:pt-20 lg:pb-20">
    <div class="relative z-[2]">
      <p class="lx-badge" data-reveal><i aria-hidden="true"></i>{availability.statusLabel} · Software Engineer</p>
      <h1 id="hero-title" class="lx-h1 mt-7" data-reveal style="--reveal-delay:80ms">
        I ship <span class="lx-shine">AI-powered</span> products businesses <span class="lx-serif">use daily.</span>
      </h1>
      <p class="lx-lead mt-7 max-w-[34rem]" data-reveal style="--reveal-delay:160ms">
        I’m <strong class="font-semibold text-fg">Pankaj Parihar</strong> — 2.5+ years building CRM &amp; ERP at Dial ERP
        with Angular, ASP.NET Core and Azure OpenAI. Creator of <strong class="font-semibold text-fg">2026.co.in</strong>, a
        QR-ordering platform live in cafés.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:240ms">
        <a href="#projects" class="lx-btn lx-btn-dark">See my work <Icon name="lucide:arrow-right" class="size-[1.1rem]" /></a>
        <a href={resume.pdf} class="lx-btn lx-btn-light" download data-track="resume_download" data-track-source="hero">
          <Icon name="lucide:download" class="size-[1.1rem]" /> Download résumé
        </a>
      </div>
      <p class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted" data-reveal style="--reveal-delay:320ms">
        <a href="/resume/" data-open-summary class="inline-flex items-center gap-1.5 font-medium text-fg hover:text-primary">
          <Icon name="lucide:zap" class="size-4 lx-gold" /> 30-second summary
        </a>
        <span aria-hidden="true">·</span>
        <span>Currently at Dial ERP Technology</span>
        <span aria-hidden="true">·</span>
        <span>India (IST)</span>
      </p>
    </div>

    <div class="lx-stage" data-reveal style="--reveal-delay:200ms">
      <div class="lx-halo" aria-hidden="true"><span></span><span></span></div>
      <figure class="lx-portrait" data-depth="10">
        <Image
          src={photo}
          alt="Portrait of Pankaj Parihar"
          widths={[480, 720, 960, 1121]}
          sizes="(min-width:1024px) 32vw, 80vw"
          quality={92}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="lx-plate">
          <span class="lx-plate-name">Pankaj Parihar</span>
          <span class="lx-plate-role"><span>Angular · Flutter</span> <span>.NET · Azure AI</span></span>
        </figcaption>
      </figure>
      <a href="/projects/2026-co-in/" class="lx-shot lx-shot-mini" data-depth="34" tabindex="-1" aria-hidden="true">
        <Image src={shotQr} alt="" widths={[480, 720]} sizes="(min-width:1024px) 22vw, 50vw" loading="eager" class="lx-float-slow" />
      </a>
      <div class="lx-chip lx-chip-a" data-depth="48" aria-hidden="true">
        <span class="lx-chip-icon"><Icon name="lucide:circle-check" class="size-5" /></span>
        <span>Live in production<small>2026.co.in · cafés</small></span>
      </div>
      <div class="lx-chip lx-chip-b" data-depth="-26" aria-hidden="true">
        <span class="lx-chip-icon"><Icon name="lucide:sparkles" class="size-5" /></span>
        <span>AI chatbot<small>Azure OpenAI + RAG</small></span>
      </div>
    </div>
  </div>

  <div class="container-page pb-14">
    <dl class="lx-stats">
      {
        stats.map((s, i) => (
          <div class="lx-stat" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <b>{s.value}</b>
              <span aria-hidden="true">{s.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="lx-logos mt-14" aria-label="Technologies">
      <p class="sr-only">{techStrip.map((t) => t.name).join(', ')}</p>
      <ul aria-hidden="true">
        {
          [...techStrip, ...techStrip].map((t) => (
            <li>
              <Icon name={t.icon} class="size-5" />
              {t.name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
