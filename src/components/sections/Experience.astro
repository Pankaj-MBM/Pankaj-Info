---
import { experience } from '@/data/experience';
import { durationLabel, formatPeriod } from '@/lib/format';
import Icon from '../ui/Icon.astro';
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container-page">
    <h2 id="experience-title" class="section-title">Experience</h2>
    <ol class="exp-list mt-14">
      {
        experience.map((job) => {
          const duration = durationLabel(job.start, job.end);
          return (
            <li class="exp-row" data-reveal>
              <div class="exp-when">
                <p>{formatPeriod(job.start, job.end)}</p>
                {duration && <p class="text-muted">{duration}</p>}
                <p class="text-muted">{job.location}</p>
              </div>
              <div>
                <h3 class="exp-role">
                  {job.role} <span class="text-muted">at</span> <span class="text-primary">{job.company}</span>
                </h3>
                <ul class="exp-points">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <p class="exp-stack">{job.stack.join(' · ')}</p>
                {job.caseStudy && (
                  <a href={job.caseStudy.href} class="arrow-link mt-5">
                    {job.caseStudy.label} <Icon name="lucide:arrow-right" class="size-4" />
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
