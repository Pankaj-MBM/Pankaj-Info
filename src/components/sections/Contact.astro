---
import { profile } from '@/data/profile';
import LocalTime from '../features/LocalTime.astro';
import Icon from '../ui/Icon.astro';

/** Catalyst function that emails the message (functions/contact). Empty → the form offers Gmail/WhatsApp hand-off. */
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? 'https://pankaj.2026.co.in/server/contact/';
const { socials, contact, resume } = profile;
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="lx-contact" data-reveal>
      <div class="grid gap-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="lx-eyebrow">Contact</p>
          <h2 id="contact-title" class="lx-title mt-5">Have a role in mind? <span class="lx-serif" style="color:#d8b77a">Let’s talk.</span></h2>
          <button type="button" class="lx-email" data-copy-email>
            <span data-email-text>{contact.emailUser} [at] {contact.emailDomain}</span>
          </button>
          <p class="lx-contact-muted mt-3 flex items-center gap-2 text-sm"><Icon name="lucide:copy" class="size-4" /> Click the address to copy it</p>
          <ul class="lx-contact-links">
            <li><a href="#contact" data-whatsapp><Icon name="si:whatsapp" class="size-4" /> WhatsApp</a></li>
            <li>
              <button type="button" data-reveal-phone>
                <Icon name="lucide:phone" class="size-4" />
                <span data-phone-text>Show phone</span>
              </button>
            </li>
            <li><a href={socials.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin_click" data-track-source="contact"><Icon name="si:linkedin" class="size-4" /> LinkedIn</a></li>
            <li><a href={socials.github} target="_blank" rel="noopener noreferrer" data-track="github_click" data-track-source="contact"><Icon name="si:github" class="size-4" /> GitHub</a></li>
            <li><a href={resume.pdf} download data-track="resume_download" data-track-source="contact"><Icon name="lucide:download" class="size-4" /> Résumé</a></li>
          </ul>
          <p class="lx-contact-muted mt-8 text-sm">
            It’s <LocalTime /> for me · <span data-tz-relation>India Standard Time</span> · I usually reply within 24 hours.
          </p>
        </div>

        <form class="lx-form grid gap-5" data-contact-form data-endpoint={contactEndpoint} novalidate>
          <p class="text-lg font-semibold tracking-[-0.015em]">Send a message</p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" data-label="name" aria-describedby="cf-name-error" />
              <p id="cf-name-error" class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="120" data-label="email" aria-describedby="cf-email-error" />
              <p id="cf-email-error" class="field-error" hidden></p>
            </div>
          </div>
          <div class="field">
            <label for="cf-company">Company <span class="font-normal text-muted">(optional)</span></label>
            <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="120" />
          </div>
          <div class="field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" required minlength="10" maxlength="3000" data-label="message" aria-describedby="cf-message-error" placeholder="The role, the team, and how I can help…"></textarea>
            <p id="cf-message-error" class="field-error" hidden></p>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="cf-botcheck">Leave this empty</label>
            <input id="cf-botcheck" type="checkbox" name="botcheck" tabindex="-1" />
          </div>
          <div class="form-status" data-form-status role="status" aria-live="polite" hidden></div>
          <button type="submit" class="lx-btn lx-btn-dark justify-self-start">
            <span class="btn-spinner" aria-hidden="true"></span>
            <Icon name="lucide:send" class="btn-icon size-[1.1rem]" />
            <span data-submit-label>Send message</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '@/scripts/contact';
  initContactForm();
</script>
