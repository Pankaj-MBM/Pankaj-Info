---
/** About: a confident statement + principles and background. */
import { profile } from '@/data/profile';
import { education } from '@/data/education';

const principles = [
  ['Business first', 'I learn the workflow before I touch the code — the best feature is often the one you don’t build.'],
  ['Data & APIs before screens', 'Clean models and contracts make every screen after them easier.'],
  ['AI-augmented, human-owned', 'I use AI to move faster, then review, test and own every line that ships.'],
];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container-page grid gap-14 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-20">
    <div data-reveal>
      <p class="lx-eyebrow">About</p>
      <h2 id="about-title" class="sr-only">About Pankaj</h2>
      <p class="lx-quote mt-6">
        I turn messy business workflows into <span class="lx-serif lx-gold">calm, fast software</span> — from WhatsApp
        automation and AI assistants to a QR-ordering platform that runs in real cafés.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          education.map((e) => (
            <div>
              <p class="font-semibold">{e.degree}</p>
              <p class="text-sm text-muted">
                {e.school} · {e.year ? `${e.year} · ` : ''}{e.score}
              </p>
            </div>
          ))
        }
        <div>
          <p class="font-semibold">Languages</p>
          <p class="text-sm text-muted">{profile.languages.join(' · ')}</p>
        </div>
        <div>
          <p class="font-semibold">Based in</p>
          <p class="text-sm text-muted">India · {profile.location.tzAbbr} ({profile.location.tzOffset})</p>
        </div>
      </div>
    </div>
    <div class="lx-panel self-start" data-reveal style="--reveal-delay:120ms">
      <p class="lx-eyebrow">How I work</p>
      <ol class="mt-6">
        {
          principles.map(([title, text], i) => (
            <li class="lx-principle">
              <span>0{i + 1}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
