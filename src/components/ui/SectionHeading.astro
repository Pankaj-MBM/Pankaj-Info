---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  accent?: string;
  intro?: string;
  id: string;
}
const { index, eyebrow, title, accent, intro, id } = Astro.props;
---

<div class="max-w-2xl" data-reveal>
  <p class="eyebrow"><span aria-hidden="true">{index} — </span>{eyebrow}</p>
  <h2 id={id} class="mt-3 text-[clamp(2rem,4.5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.025em]">
    {title}
    {accent && <span class="accent-serif text-primary text-[1.08em]">{accent}</span>}
  </h2>
  {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
</div>
